{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/security.txt",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|.*\\.(?:png|jpg|jpeg|gif|svg|ico|txt|js|css)$).*)",
      "destination": "/index.html"
    }
  ]
}
