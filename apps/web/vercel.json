{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/.well-known/security.txt",
      "destination": "/well-known/security.txt"
    },
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|well-known/|.*\\.(?:png|jpg|jpeg|gif|svg|ico|txt|js|css)$).*)",
      "destination": "/index.html"
    }
  ]
}
